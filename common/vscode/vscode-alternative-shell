#!/usr/bin/bash

# shellcheck disable=SC2155
# shellcheck disable=SC2329 # unused functions

output() {
	echo "$*" >&2
}
log() {
	output "[vscode shell] $*"
}
die() {
	log "$*"
	log "the modified script is at '${TMPF}' on server."
	exit 123
}
append_script() {
	echo "$*" >>"${TMPF}"
}

SELF="$(realpath "${BASH_SOURCE[0]}")"
if [[ $SHELL == "$SELF" ]]; then
	SHELL="$(command -v bash)"
fi

if [[ $SHELL != *"bash"* ]]; then
	# 此脚本需要bash运行，通常就是bash，但有些错误实现的系统会忽略shebang
	if [[ $# -eq 0 ]]; then
		set -- "${SELF}"
	fi

	log "current shell is ${SHELL}, re-execute as bash -$- $*"
	export SHELL=/usr/bin/bash
	exec /usr/bin/bash "-$-" "$@"
fi

set -Eeuo pipefail
shopt -s inherit_errexit extglob nullglob globstar lastpipe shift_verbose

hack_vscode_protocol() {
	### 标准输入的脚本来自vscode客户端，通过ssh输入过来，原本会直接bash执行
	while read -r LINE; do
		if [[ -z ${LINE} ]]; then
			append_script ""
			continue
		elif [[ ${LINE} == *mainScriptWrapper* ]]; then
			# 看到[主函数定义]的起始行，开始处理脚本
			{
				echo ""
				echo "### ========================= 注入脚本开始 ========================="
				inject_script_before_main
				echo "### ========================= 注入脚本结束 ========================="
				echo ""
				echo "${LINE}"
				stdin_scripts_processor
				echo ""
			} >>"${TMPF}"

			# 处理成功！
			return 0
		elif [[ ${LINE} == bash || ${LINE} == sh ]]; then
			# vscode会首先启动sh，然后向他输出脚本，这里跳过
			append_script "# [skip   ] ${LINE}"
			# output "[skip   ] ${LINE}"
		else
			# 本应由sh执行的内容
			# 基本信息，目前观察到这部分只剩下uname一个命令了
			append_script "# [execute] ${LINE}"
			# output "[execute] ${LINE}"
			eval "${LINE}"
		fi
	done

	log "读取输入时遇到意外的文件尾"
	exit 123
}

inject_script_before_main() {
	### 替换 wget 命令，输出调试信息，vscode使用wget下载一个很小的cli，较大的服务器程序由此cli下载，不经过wget
	local P_TTY="/proc/$$/fd/2"
	local WGET="$(command -v wget)"
	log "wget 为: ${WGET} | 替换为将输出写入 ${P_TTY}"
	function wget() {
		local ARGS=("$@") WGET="${WGET}"
		log "wget 被调用: ${ARGS[*]}"
		"___WGET___" "${ARGS[@]}" 2>&1 | tee "___P_TTY___"
	}
	declare -f wget | sed -E "s:___WGET___:${WGET}:g; s:___P_TTY___:${P_TTY}:g"
	unset -f wget

	### 替换 sleep 命令
	# 当useExecServer=true时:
	# * vscode安装脚本首先会下载一个cli，此cli会启动实际的服务器程序
	# * 此时脚本用sleep等待服务器程序启动（下载）；以及其他一些东西，该等待时间为0.x~3秒，这种情况直接调用sleep
	# 当useExecServer=false时:
	# * vscode安装脚本直接在当前shell安装服务器程序
	#
	# 一切准备好后，脚本会进入一个死循环，每次等待180秒并随便输出，以此判断连接是否断开
	# 但由于用systemd另外启动的server，断开连接不会导致“随便输出”出错，也就不能判断连接情况
	# 用判断父进程PID是否还在来实现相同功能（并不稳定）
	#
	# 实际不应该判断父进程，而是子进程（vscode server）是否还在
	cat <<-'EOF'
		SLEEP_BIN=$(command -v sleep)
		PARENT_NOTIFIED=''
		log "替换 sleep $SLEEP_BIN 为函数"
	EOF

	_check_user_alive() {
		local SLICE_NAME="vscode-${COMMIT_ID}.slice"
		local LIST
		LIST=$(systemctl show --property=RequiredBy --value "$SLICE_NAME")

		# 如果有 vscode-await-xxx.service 存在，则说明还有人使用此server，返回0使sleep继续等待
		[[ " $LIST " == *"vscode-await-"* ]]
	}
	_parent_notify() {
		if [[ ! ${PARENT_NOTIFIED-} ]]; then
			log "通知systemd: vscode-server 已经准备好"
			PARENT_NOTIFIED=yes
			NOTIFY_SOCKET="$_NOTIFY_SOCKET" systemd-notify --ready
			unset _NOTIFY_SOCKET
		fi
	}
	sleep() {
		local T=$1
		log "sleep ${T}"
		if [[ $T == *'.'* ]] || [[ $T -lt 30 ]]; then
			if [[ $T == '.'* ]]; then
				T=1
				log "  - 强制至少休眠 1s"
			fi
			"${SLEEP_BIN}" "$T"

			# TODO: 这里不正确，应该无论如何都运行到下方的 wait long 才对，但不知道为什么 180 秒的等待没执行，而是直接把main函数return了
			if [[ ${USING_EXEC_SERVER-} != "1" ]]; then
				log "not using exec server, notify now."
				_parent_notify
			fi

			return
		fi
		# wait long, server is (hopefully) stable
		_parent_notify

		if [[ ${USING_EXEC_SERVER-} != "1" ]]; then
			# 不是使用 exec server（每个远程窗口独立启动一个）需要想办法，但这种情况目前没用到，暂时不管
			"${SLEEP_BIN}" "$T"
		elif [[ "${CLI_PID-}" ]]; then
			if _check_user_alive; then
				# 还有人在用此server，则按照vscode原本的逻辑，继续等待
				"${SLEEP_BIN}" "$T"
			else
				# 如果无人使用，则退出
				# 此shell是systemd-run启动的leader，这会导致systemd自动清理所有内容
				exit 0
			fi
		else
			die "vscode remote内部变化: 环境变量 CLI_PID 没有了"
		fi
	}
	declare -f sleep _check_user_alive _parent_notify
	unset -f sleep _check_user_alive _parent_notify
}

# 处理标准输入脚本，此函数输出会写到临时文件中供systemd-run执行
stdin_scripts_processor() {
	# {
	# 	echo =============================================
	# 	env
	# 	echo =============================================
	# } >&2

	function __replace_re() {
		# 构造正则匹配，用于在标准输入的代码中替换变量赋值
		local VAL="${2-${!1}}" KEY="$1"
		printf "s|^%s=.*$|%s=\"%s\"|" "$KEY" "$KEY" "${VAL}"
	}

	MODIFY_REG=''
	MODIFY_REG+="$(__replace_re VSCODE_AGENT_FOLDER);"
	MODIFY_REG+="$(__replace_re SERVER_DIR "${VSCODE_AGENT_FOLDER}");"
	MODIFY_REG+="$(__replace_re VSC_TMP);"

	MODIFY_REG+="$(__replace_re IGNORE_WGET_CONFIG_FLAG "");"
	if wget --version | grep -qiF wget2; then
		MODIFY_REG+="$(__replace_re WGET_TRIES_SEGMENT "--force-progress --read-timeout=10 --continue");"
	else
		MODIFY_REG+="$(__replace_re WGET_TRIES_SEGMENT "--progress=bar --show-progress --read-timeout=10 --continue");"
	fi

	# 替换远程服务器的代理设置，cli下载服务器程序时会遵守这些环境变量
	# xxx_INPUT 是vscode脚本中的变量，值为远程客户端设置中的代理地址
	if [[ -n ${PROXY:-} ]]; then
		log "覆盖 proxy 设置为本（远程）机环境: ${PROXY}"
		HTTP_PROXY_INPUT="${PROXY}"
		HTTPS_PROXY_INPUT="${PROXY}"
		export https_proxy=${PROXY} http_proxy=${PROXY} all_proxy=${PROXY} \
			HTTPS_PROXY=${PROXY} HTTP_PROXY=${PROXY} ALL_PROXY=${PROXY} \
			NO_PROXY="10.*,192.*,127.*,172.*"
	else
		log "覆盖 proxy 设置为空串"
		HTTP_PROXY_INPUT=""
		HTTPS_PROXY_INPUT=""
	fi

	MODIFY_REG+="$(__replace_re HTTP_PROXY_INPUT "${HTTP_PROXY_INPUT}");"
	MODIFY_REG+="$(__replace_re HTTPS_PROXY_INPUT "${HTTPS_PROXY_INPUT}");"

	### 标准输入的脚本来自vscode客户端，通过ssh输入过来，原本会直接bash执行
	FOUND_USING_EXEC_SERVER=0
	FOUND_COMMIT_ID=
	while read -r LINE; do
		# 正则替换脚本中的变量赋值，然后记录到临时文件
		STMT=$(echo "${LINE}" | sed --unbuffered -E "${MODIFY_REG}")
		echo "${STMT}"

		# 只有 useExecServer=true 的时候才会有 execServerToken 这个语句，以此判断并记录到脚本中（供sleep使用）
		if [[ $FOUND_USING_EXEC_SERVER == '0' ]] && [[ ${STMT} == *"execServerToken"* ]]; then
			log "发现配置 'useExecServer' 为 true"
			FOUND_USING_EXEC_SERVER=1
			echo "declare -r USING_EXEC_SERVER=1"
		fi
		if [[ $FOUND_COMMIT_ID == '' ]] && [[ ${STMT} == "COMMIT_ID="* ]]; then
			FOUND_COMMIT_ID=$(echo "${STMT}" | sed -E 's/^COMMIT_ID="//; s/"$//')
			log "发现 commitId 为 <${FOUND_COMMIT_ID}>"
			export FOUND_COMMIT_ID
		fi

		if [[ ${LINE} == "mainScriptWrapper" ]]; then
			log "看到主函数的实际调用！"
			echo "log 'mainScriptWrapper 居然返回了？！这不可能'"
			echo "sleep infinity"
			return 0
		fi
	done

	die "protocol changed: missing main function call"
}

execute_main() {
	printf "\e[32mserver hello: starting vscode remote shell\e[0m\n"

	### 加载服务器上的环境变量文件
	# 目的是读出 VSCODE_AGENT_FOLDER 和 VSCODE_AS_USER
	# 其他是附带，会传递给子进程
	if [[ -e /etc/profile.d/50-environment.sh ]]; then
		log "load system environment"
		source /etc/profile.d/50-environment.sh
	fi
	if [[ -e /etc/profile.d/vscode.sh ]]; then
		log "load static environment"
		# shellcheck source=/dev/null
		source /etc/profile.d/vscode.sh
	fi
	if [[ -e "${HOME-}/.bash_environment.sh" ]]; then
		log "load user environment"
		source "${HOME}/.bash_environment.sh"
	else
		log "user environment not exists: ${HOME-}/.bash_environment.sh"
	fi

	### 如果发现没有设置 VSCODE_AGENT_FOLDER，则直接运行 bash，仿佛此文件不存在
	if [[ -z ${VSCODE_AGENT_FOLDER-} ]]; then
		log "no VSCODE_AGENT_FOLDER on this machine, skip alternative shell..."
		exec /usr/bin/bash "$@"
	fi
	if [[ $VSCODE_AGENT_FOLDER == *"/" ]]; then
		VSCODE_AGENT_FOLDER=${VSCODE_AGENT_FOLDER%/}
	fi
	export VSCODE_AGENT_FOLDER
	if [[ -n ${VSCODE_ALTERNATIVE-} ]]; then
		log "VSCODE_ALTERNATIVE is '${VSCODE_ALTERNATIVE}'"
		VSCODE_AGENT_FOLDER+="/Alternatives/${VSCODE_ALTERNATIVE}"
	else
		log "VSCODE_ALTERNATIVE is not set, using default"
	fi
	log "force vscode install to ${VSCODE_AGENT_FOLDER}"

	### 准备运行临时目录
	if [[ -n ${XDG_RUNTIME_DIR-} ]]; then
		VSC_TMP="${XDG_RUNTIME_DIR}/vscode-server"
	else
		VSC_TMP="/run/vscode-server/${UID-$(id -u)}"
		mkdir -p --mode 0777 "/run/vscode-server"
	fi
	mkdir -p "${VSC_TMP}"
	export VSC_TMP

	S_ID=${XDG_SESSION_ID-}
	if [[ -z ${XDG_SESSION_ID-} ]]; then
		S_ID=${RANDOM}
	fi
	export S_ID

	# 用于接收标准输入脚本
	local -r TMPF="${VSC_TMP}/install-script.${S_ID}.sh"
	log "SCRIPT WILL DUMP TO $TMPF"

	declare -f output die >"$TMPF"
	cat <<-'PREPARE' >>"$TMPF"
		log() {
			output "[vscode shell][child] $*"
		}
		log "subshell is started."
		if [[ -z "$NOTIFY_SOCKET" ]]; then
			die "missing NOTIFY_SOCKET"
		fi
		log "NOTIFY_SOCKET=${NOTIFY_SOCKET}"

		export _NOTIFY_SOCKET="${NOTIFY_SOCKET}"
		unset INVOCATION_ID NOTIFY_SOCKET MEMORY_PRESSURE_WATCH MEMORY_PRESSURE_WRITE
	PREPARE

	# 计算systemd-run参数，附带一些环境变量
	local SYSTEMD_RUN_ARGS=()
	local -a SYSTEMD_RUN_CMD
	if [[ $(id -u) -eq 0 ]]; then
		log "running as root"
		SYSTEMD_RUN_CMD=(systemd-run --system)
	elif [[ ${VSCODE_AS_USER:-} != yes ]]; then
		log "running as user, using sudo [VSCODE_AS_USER=${VSCODE_AS_USER:-}]"
		SYSTEMD_RUN_CMD=(sudo systemd-run --system)
		declare -x HOME=/root
		unset DBUS_SESSION_BUS_ADDRESS XDG_SESSION_ID XDG_RUNTIME_DIR
	else
		log "running as user, using --user session [VSCODE_AS_USER=${VSCODE_AS_USER:-}]"
		SYSTEMD_RUN_CMD=(systemd-run --user)
	fi

	# 父进程PID，实际就是sshd-session
	export SESSION_ROOT_PID=${PPID}

	# 存放环境变量，交给子进程使用
	{
		export -p | grep -viE ' (USER|SHLVL|PWD|OLDPWD|_|MEMORY_PRESSURE_[A-Z_]+)='

		if [[ ${SYSTEMD_RUN_CMD[0]} == "sudo" ]]; then
			# 如果涉及sudo，则脚本中还需加载root用户的环境变量文件，不能让上面export出去的优先于root自己的设置
			cat <<-EOF
				if [[ -e "/root/.bash_environment.sh" ]]; then
					log "load root user environment"
					source "/root/.bash_environment.sh"
				else
					log "root user environment not exists: /root/.bash_environment.sh"
				fi
			EOF
		fi

		echo "##### environment part completed"
	} >>"${TMPF}"

	# 和vscode交互，等待脚本传输完成
	hack_vscode_protocol

	if [[ -z ${FOUND_COMMIT_ID-} ]]; then
		die "脚本结构变化，或者意外进入subshell，未发现 commitId"
	fi

	# 此文件路径在安装脚本中
	if [[ ! -e /tmp/vscode-skip-server-requirements-check ]]; then
		touch /tmp/vscode-skip-server-requirements-check
	fi

	# 创建两个fifo文件，用于把vscode-cli的输出传递给远程客户端
	local PASS_STDOUT="${VSC_TMP}/.stdout.${S_ID}.fifo"
	local PASS_STDERR="${VSC_TMP}/.stderr.${S_ID}.fifo"
	mkfifo --mode 0777 "${PASS_STDOUT}" "${PASS_STDERR}"

	local CAT_PS1 CAT_PS2
	cat "${PASS_STDERR}" >&2 &
	CAT_PS1=$!
	cat "${PASS_STDOUT}" &
	CAT_PS2=$!

	x() {
		echo "+ $*" >&2
		"$@"
	}

	# shared
	SHARED_ARGS=(
		--collect
		"--slice=vscode-${FOUND_COMMIT_ID}.slice"
		"--working-directory=$VSC_TMP"
	)

	# 启动一个进程，当父进程（即sshd-session）退出时，关闭辅助进程
	# 并且要用systemd-run的方式启动，并加入 vscode-xxx.slice，随后可以通过查询此slice有几个这种tools进程来判断是否还有用户
	local HELPER_NAME="vscode-await-${SESSION_ROOT_PID}.service"
	SESSION_TOOL_ARGS=(
		"--unit=${HELPER_NAME}"
	)
	if [[ -n $XDG_RUNTIME_DIR ]]; then
		SESSION_TOOL_ARGS+=("--property=ExecStopPost=-$(command -v loginctl) terminate-session $XDG_SESSION_ID")
	else
		SESSION_TOOL_ARGS+=("--property=ExecStopPost=-$(command -v kill) -9 $CAT_PS1 $CAT_PS2")
	fi
	SESSION_TOOL_ARGS+=("--property=ExecStopPost=-$(command -v rm) ${PASS_STDOUT} ${PASS_STDERR} ${TMPF}")

	log "工具服务: ${HELPER_NAME}"
	x "${SYSTEMD_RUN_CMD[@]}" \
		"${SHARED_ARGS[@]}" \
		"${SESSION_TOOL_ARGS[@]}" \
		tail "--pid=$SESSION_ROOT_PID" -f /dev/null

	local SERVICE_NAME="vscode-remote-$S_ID.service"
	log "主服务: ${SERVICE_NAME}"
	x exec "${SYSTEMD_RUN_CMD[@]}" \
		"${SHARED_ARGS[@]}" \
		"--service-type=notify" \
		"--property=NotifyAccess=all" \
		"--unit=${SERVICE_NAME}" \
		"--property=Description=Visual Studio Code Remote @ $S_ID" \
		"${SYSTEMD_RUN_ARGS[@]}" \
		"--property=StandardInput=file:${TMPF}" \
		"--property=StandardOutput=append:${PASS_STDOUT}" \
		"--property=StandardError=append:${PASS_STDERR}" \
		"--property=TimeoutStartSec=1min" \
		"--property=OOMPolicy=stop" \
		"--property=OOMScoreAdjust=200" \
		"--property=Nice=15" \
		"--property=LimitNICE=10" \
		/usr/bin/bash --norc --noprofile
}

execute_main "${@}"
unset -f execute_main hack_vscode_protocol stdin_scripts_processor log die append_script
